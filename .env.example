# Live Google reviews on the Reviews page (optional; without these the page uses src/data/reviews.ts)
# Copy to .env, fill in, then rebuild and deploy.
# API key: Google Cloud console > enable "Places API (New)" > Credentials > restrict to your site's domains
VITE_GOOGLE_PLACES_API_KEY=
# Place ID of "Srinithi Makeup Artist": find it at https://developers.google.com/maps/documentation/places/web-service/place-id
VITE_GOOGLE_PLACE_ID=
